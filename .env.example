# Copy to `.env` and adjust as needed:  cp .env.example .env

# ─── Database (PostgreSQL) ─────────────────
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow
POSTGRES_PORT=5432

# ─── Backend (FastAPI) ─────────────────────
# Used when running the API on the host. Docker Compose overrides the host to `db`.
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
LOG_LEVEL=info
# Seed demo data on container start when the database is empty.
SEED_ON_STARTUP=true
# IANA timezone used by the seed to place "due today" follow-ups before your local midnight.
SEED_TIMEZONE=UTC

# ─── Authentication ────────────────────────
# Secret that signs session tokens (min 32 chars). Leave empty ONLY for local development.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# How long a sign-in lasts.
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Send the session cookie over HTTPS only — set to true in production.
COOKIE_SECURE=false
# Demo account created by the seed script if it doesn't exist.
DEMO_USER_EMAIL=demo@leadflow.dev
DEMO_USER_PASSWORD=leadflow123

# ─── Frontend (Next.js) ────────────────────
# Public URL of the API as seen from the browser (inlined at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000
